// Cell Shift infrastructure: the overhead cable tray module, the black hose
// drop module, and the raised-floor grid that gives the hall its cel-shift
// tile pattern. All three are authored around their own origin so the hall can
// place them at ceiling, drop, and floor height.
(
    asset: "infrastructure",
    modules: [
        (
            name: "overhead-tray",
            shapes: [
                (
                    name: "tray-base",
