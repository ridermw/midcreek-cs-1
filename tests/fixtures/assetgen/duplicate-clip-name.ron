// glTF animation names live on the document, so two rigged modules in one
// source must not both declare a clip called "Idle".
(
    asset: "duplicate-clip-name",
    modules: [
        (
            name: "first",
            rig: Some((
                skin_node: "first-skin",
                bones: [
                    (name: "bone-hips", parent: None, translation: (0.0, 0.95, 0.0)),
                ],
                clips: [
                    (
                        name: "Idle",
                        duration: 1.0,
                        tracks: [
                            (bone: "bone-hips", channel: Rotation, keys: [
                                (time: 0.0, value: (0.0, 0.0, 0.0)),
                                (time: 1.0, value: (0.0, 0.0, 0.0)),
                            ]),
                        ],
                    ),
                ],
            )),
            shapes: [
                (
                    name: "body",
                    role: WorkerSlate,
                    bone: Some("bone-hips"),
                    primitive: Box(center: (0.0, 0.95, 0.0), half_extents: (0.2, 0.2, 0.1)),
                ),
            ],
        ),
        (
            name: "second",
            rig: Some((
                skin_node: "second-skin",
                bones: [
                    (name: "bone-hips", parent: None, translation: (0.0, 0.95, 0.0)),
                ],
                clips: [
                    (
                        name: "Idle",
                        duration: 1.0,
                        tracks: [
                            (bone: "bone-hips", channel: Rotation, keys: [
                                (time: 0.0, value: (0.0, 0.0, 0.0)),
                                (time: 1.0, value: (0.0, 0.0, 0.0)),
                            ]),
                        ],
                    ),
                ],
            )),
            shapes: [
                (
                    name: "body",
                    role: WorkerSlate,
                    bone: Some("bone-hips"),
                    primitive: Box(center: (0.0, 0.95, 0.0), half_extents: (0.2, 0.2, 0.1)),
                ),
            ],
        ),
    ],
)
